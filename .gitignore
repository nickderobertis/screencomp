# Build + release artifacts
/target
/dist

# Coverage / profiling
*.profraw
*.profdata
/lcov.info

# rustfmt backups
**/*.rs.bk

# Local environment / secrets (the CLI reads only process env, never .env files)
.env
.env.*

# Local dev-setup state (stamp, log, lock) and direnv's cache — machine-specific
/.dev/
/.direnv/

# Personal Claude Code settings (per-machine hooks/permissions; not shared)
/.claude/settings.local.json

# OS noise
.DS_Store
