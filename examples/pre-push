#!/usr/bin/env bash
# screencomp local pre-push guard — COPY-PASTE TEMPLATE.
#
# Local half of the STRICT gate (the recommended model): CI hard-fails when a
# capture drifts from the committed baseline, and this hook lets you regenerate
# and COMMIT the new baseline before pushing, so CI stays green on intended
# changes and goes red only on ones you missed. It re-captures ONLY when
# screenshot-relevant files changed (see [guard].paths in screencomp.toml) and
# makes any baseline change loud and reviewable before you push. Capture and git
# stay in your hands — the capture step below is yours to adapt, exactly like
# visual-docs.yml's "Capture screenshots" step. `screencomp init` scaffolds this
# same hook at .githooks/pre-push; it detects the host arch at runtime, so the one
# committed hook is correct on every developer's machine.
#
# The whole loop when you change something visual: edit, then `git push`. This
# hook captures (only if [guard].paths changed) and, on drift, regenerates the
# baseline + builds a review gallery and BLOCKS — then you review the gallery,
# `git add` the baseline, commit, and push again. That is the entire workflow,
# local-first by design: you own the baseline, so don't wait for CI to handle
# drift. Don't pre-check your environment either — your CPU arch is auto-detected
# below (CI gates its own arch lane; local and CI never need to match) and Docker
# is checked before capture and fails loudly if missing. Just run the loop.
#
# What it does on a push:
#   1. Compute the push range from git's stdin (new branches fall back to the
#      merge-base with origin/HEAD).
#   2. Ask `screencomp scope` whether any changed path matches [guard].paths.
#      Nothing relevant? Exit 0 immediately — no capture, no Docker. (Cheap: this
#      is the common case on most pushes.)
#   3. Relevant change? Require Docker (a missing capture environment is a loud
#      failure, never a silent pass), capture, then classify against the
#      committed manifest.
#        * In parity  -> print one line and allow the push.
#        * On drift    -> overwrite the manifest, build a review gallery, print
#                         exactly what changed and what to do, then BLOCK the
#                         push. It never auto-commits: you review the gallery,
#                         commit the regenerated manifest, and push again.
#
# Bypass (when you know what you are doing):  git push --no-verify
# Under CI this is a no-op — the visual-docs workflow is the source of truth.
#
# Wiring (lefthook / husky / simple-git-hooks / raw .git/hooks): see
# examples/hooks/README.md.

set -euo pipefail

# Captures always run in a Linux container, so the OS never varies; the only
# dimension that affects pixels is the CPU arch. Detect THIS machine's arch at
# runtime so the same committed hook works for every developer (ARM and amd64 devs
# each capture and classify under their own arch). It must be one of
# [capture].arches in screencomp.toml; if not, classify below fails with an
# explanatory error telling you to add it.
case "$(uname -m)" in
  arm64 | aarch64) ARCH="arm64";  DOCKER_PLATFORM="linux/arm64" ;;
  x86_64 | amd64)  ARCH="x86_64"; DOCKER_PLATFORM="linux/amd64" ;;
  *) echo "pre-push: unsupported arch $(uname -m); bypass with git push --no-verify" >&2; exit 1 ;;
esac

# ---- adapt these to your repo; mirror screencomp.toml's [guard] --------------
MANIFEST="shots/baseline/${ARCH}.json"        # committed baseline for this arch
GALLERY="shots/review"                        # [guard].gallery  (review output)
CURRENT="shots/current"                       # capture root, mirrors visual-docs.yml
CONFIG="${SCREENCOMP_CONFIG:-screencomp.toml}" # supplies [guard].paths to `scope`
# ------------------------------------------------------------------------------

# No-op under CI: the workflow already captures, classifies, and comments there.
if [ -n "${CI:-}" ]; then
  exit 0
fi

# Without the CLI the guard CANNOT evaluate the push, so do NOT pass silently — a
# strict gate the developer believes is protecting them but isn't is the worst
# outcome (it was). Warn loudly and skip; set SCREENCOMP_GUARD_REQUIRE=1 to make a
# missing CLI a hard failure instead (the safest default once everyone has it).
if ! command -v screencomp >/dev/null 2>&1; then
  {
    echo "pre-push: screencomp is NOT on PATH — the visual guard cannot run."
    echo "          Install it: https://github.com/nickderobertis/screencomp#install"
    echo "          then enable the hook: git config core.hooksPath .githooks"
    echo "          CI still gates this. Set SCREENCOMP_GUARD_REQUIRE=1 to fail here instead."
  } >&2
  [ -n "${SCREENCOMP_GUARD_REQUIRE:-}" ] && exit 1
  exit 0
fi

# --- 1. Compute the push range(s) --------------------------------------------
# git feeds "<local-ref> <local-sha> <remote-ref> <remote-sha>" lines on stdin.
# A 40/64-zero sha means a new remote ref (no upstream yet) or a deletion.
ranges=()
if [ -n "${SCREENCOMP_GUARD_RANGE:-}" ]; then
  # Test/override hook: skip stdin and diff this range directly (e.g. A..B).
  ranges+=("$SCREENCOMP_GUARD_RANGE")
else
  zero='^0+$'
  while read -r _local_ref local_sha _remote_ref remote_sha; do
    [ -z "${local_sha:-}" ] && continue
    if [[ "$local_sha" =~ $zero ]]; then
      continue # branch deletion: nothing to capture
    elif [[ "$remote_sha" =~ $zero ]]; then
      # New branch: diff against where it forked from the default branch.
      base="$(git merge-base origin/HEAD "$local_sha" 2>/dev/null || true)"
      if [ -n "$base" ]; then
        ranges+=("${base}..${local_sha}")
      else
        ranges+=("$local_sha") # no merge-base (e.g. orphan): diff the whole commit
      fi
    else
      ranges+=("${remote_sha}..${local_sha}")
    fi
  done
fi

if [ "${#ranges[@]}" -eq 0 ]; then
  exit 0
fi

changed="$(for r in "${ranges[@]}"; do git diff --name-only "$r"; done | sort -u)"

# --- 2. Cheap path: is anything screenshot-relevant? -------------------------
# `scope` exits 3 when a changed path matches [guard].paths, 0 when none do, and
# any OTHER non-zero on error (an old CLI without `scope`, a bad config, ...).
# Treat ONLY exit 3 as relevant; on an error, warn and skip rather than assume
# relevance and pay for a full capture — CI is the backstop, so a false "relevant"
# here is the wrong bet (and the bug an "any non-zero == relevant" check caused).
set +e
printf '%s\n' "$changed" | screencomp scope --config "$CONFIG" --changed-from - --exit-code --quiet
scope_status=$?
set -e
case "$scope_status" in
  0) exit 0 ;; # nothing relevant: pass silently, no capture
  3) : ;;      # a relevant path matched: fall through to capture
  *)
    echo "pre-push: 'screencomp scope' failed (exit $scope_status); skipping the" >&2
    echo "          visual guard. Is screencomp current? CI still gates this." >&2
    exit 0
    ;;
esac

# --- 3. Relevant change: capture requires Docker -----------------------------
# A green push without a working capture environment is FALSE assurance, so a
# missing Docker is a loud, blocking failure — not a silent pass.
if ! command -v docker >/dev/null 2>&1 || ! docker info >/dev/null 2>&1; then
  {
    echo
    echo "############################################################################"
    echo "# screencomp pre-push guard: screenshot-relevant files changed, but Docker  #"
    echo "# is not available to re-capture and verify them.                           #"
    echo "#                                                                           #"
    echo "# Refusing to push: a pass here would be false assurance. Start Docker and  #"
    echo "# try again, or bypass intentionally with:  git push --no-verify            #"
    echo "############################################################################"
    echo
  } >&2
  exit 1
fi

# Pass the host's extra CA bundle into the capture container so a TLS-intercepting
# egress proxy (corporate networks, Codespaces, some remote/hosted dev envs) does
# not break `npm ci` with SELF_SIGNED_CERT_IN_CHAIN — which npm surfaces only as
# the cryptic `Exit handler never called!` until you re-run with --loglevel
# verbose. No-op when no such bundle is configured, so it is safe everywhere.
ca_args=()
host_ca="${NODE_EXTRA_CA_CERTS:-${SSL_CERT_FILE:-}}"
if [ -n "$host_ca" ] && [ -f "$host_ca" ]; then
  ca_args+=(-v "$host_ca:/host-ca.crt:ro" \
    -e NODE_EXTRA_CA_CERTS=/host-ca.crt -e SSL_CERT_FILE=/host-ca.crt)
fi

# ---- adapt this to YOUR stack (clearly marked, like visual-docs.yml) ---------
# Capture into $CURRENT/$ARCH/captures.json (plus the PNGs it references) using the
# SAME pinned container and flags as examples/visual-docs.yml, so local bytes match
# CI. Your capture step writes captures.json and each shot's hash.
#
# The container runs as YOU (--user), because it bind-mounts your working tree:
# a root-running capture leaves everything it writes there — the capture output,
# and any build cache your stack drops beside it — owned by root, which you then
# cannot delete without sudo. Three things must come with that mapping or the
# container has nowhere to write, and all four stand or fall together:
#   * node_modules is masked by a directory YOU created on the host. It still
#     keeps `npm ci` inside the container, matching CI's fresh checkout instead
#     of churning (or colliding with) your host node_modules — but an anonymous
#     `-v /work/node_modules` volume is created root-owned, so under --user the
#     install would fail outright with EACCES. The mountpoint in YOUR tree is
#     created here too: Docker materializes a missing bind-mount destination as
#     root, which is the very residue this is here to prevent.
#   * HOME points into that same host scratch. Your uid has no entry in the
#     image's passwd file, so npm resolves no home and cannot write its cache.
#   * the scratch is removed however this hook exits, on drift or on error.
# The CA mounts above (if any) ride along via "${ca_args[@]}" (the +-guard keeps
# it safe under `set -u`).
host_user="$(id -u):$(id -g)"
capture_scratch="$(mktemp -d)"
trap 'rm -rf "$capture_scratch"' EXIT
mkdir -p "$capture_scratch/node_modules" "$capture_scratch/home" node_modules
docker run --rm --platform="$DOCKER_PLATFORM" --ipc=host --shm-size=2g \
  --user "$host_user" \
  -v "$PWD:/work" -v "$capture_scratch:/scratch" \
  -v "$capture_scratch/node_modules:/work/node_modules" \
  -e HOME=/scratch/home -w /work \
  ${ca_args[@]+"${ca_args[@]}"} \
  mcr.microsoft.com/playwright:v1.60.0-noble \
  bash -lc "npm ci && SHOTS_OUT=$CURRENT/$ARCH npx playwright test"
# ------------------------------------------------------------------------------

# --- 4. Classify the capture against the committed baseline manifest ---------
# No --arch needed: screencomp defaults to the host arch from [capture].arches.
set +e
report="$(screencomp classify --baseline-manifest "$MANIFEST" --current "$CURRENT" \
  --exit-code)"
status=$?
set -e

if [ "$status" -eq 0 ]; then
  # --- In parity: one confirmation line, allow the push. ---------------------
  echo "pre-push: screenshots unchanged against $MANIFEST — ok to push"
  exit 0
elif [ "$status" -ne 3 ]; then
  echo "pre-push: screencomp classify failed (exit $status)" >&2
  exit "$status"
fi

# --- On drift (classify exit 3): regenerate, build a gallery, BLOCK. ---------
differ="$(printf '%s\n' "$report" | grep -cE '^(added|changed|removed) ' || true)"

# Overwrite the committed manifest so its diff is the review record. We do NOT
# auto-commit it — blocking and instructing is the point.
screencomp manifest --input "$CURRENT" --output "$MANIFEST"

# Build a local before/after gallery to eyeball the change.
screencomp gallery --input "$CURRENT" \
  --output "$GALLERY" --title "Pre-push screenshot review" >/dev/null

{
  echo
  echo "############################################################################"
  echo "#  SCREENSHOTS CHANGED — push blocked for review                            #"
  echo "############################################################################"
  echo "#"
  echo "#  ${differ} screenshot(s) differ from the committed baseline ($MANIFEST)."
  echo "#"
  echo "#  Review the rendered gallery to confirm the change is intended:"
  echo "#      ${GALLERY}/index.html"
  echo "#      (open it, e.g.:  open ${GALLERY}/index.html   # or xdg-open on Linux)"
  echo "#"
  echo "#  If the change is intended:"
  echo "#      1. git add ${MANIFEST}"
  echo "#      2. git commit -m 'chore: update screenshot baseline manifest'"
  echo "#      3. git push   (this hook will re-run and pass once committed)"
  echo "#"
  echo "#  If it is NOT intended: investigate the diff before pushing."
  echo "#  To bypass intentionally: git push --no-verify"
  echo "#"
  echo "############################################################################"
  echo
} >&2

exit 1
